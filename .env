# Copy to .env on the server; never commit the real .env.
# Token permissions: Account > Cloudflare Tunnel > Edit;
# Zone > Zone > Read; Zone > DNS > Edit.
CF_API_TOKEN=cloudflare-api token ^^^^^^^^^
CF_ACCOUNT_ID=cloudflare account id

# Optional: SKIP_CLOUDFLARE=true
# Optional: XRAY_VERSION=v26.10.21
